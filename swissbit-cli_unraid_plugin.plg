<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
  <!ENTITY name        "swissbit-cli_unraid_plugin">
  <!ENTITY author      "james309">
  <!ENTITY version     "2026.10.08">
  <!ENTITY binVer      "1.3.0">
  <!ENTITY launch      "">
  <!ENTITY gitURL      "https://raw.githubusercontent.com/&author;/&name;/main">
  <!ENTITY pluginURL   "&gitURL;/&name;.plg">
  <!ENTITY pkgURL      "&gitURL;/packages">
  <!ENTITY plgPATH     "/boot/config/plugins/&name;">
  <!ENTITY pkgNAME     "&name;-&binVer;-x86_64">
]>

<PLUGIN name="&name;" author="&author;" version="&version;" pluginURL="&pluginURL;" min="6.9.0">

<CHANGES>
###&version;
- Decoupled binary package version from plugin release version
</CHANGES>

<!-- STEP 1: Clean up obsolete binary archives, keeping the current &binVer; -->
<FILE Run="/bin/bash">
<INLINE>
mkdir -p &plgPATH;
# Remove older binary packages, but preserve the active binVer archive
rm -f $(ls &plgPATH;/&name;*.tar.gz 2>/dev/null | grep -v '&binVer;')
</INLINE>
</FILE>

<!-- STEP 2: Download the binary tarball only if missing from flash -->
<FILE Name="&plgPATH;/&pkgNAME;.tar.gz">
<URL>&pkgURL;/&pkgNAME;.tar.gz</URL>
</FILE>

<!-- STEP 3: Extract binary to RAM rootfs on boot and verify -->
<FILE Run="/bin/bash">
<INLINE>
ARCHIVE="&plgPATH;/&pkgNAME;.tar.gz"
TARGET="/usr/local/bin/sbdm-cli"

if [ ! -f "$ARCHIVE" ]; then
  echo "ERROR: Archive package $ARCHIVE not found on flash drive."
  exit 1
fi

echo "Installing &name; (Binary v&binVer;)..."

# Extract archive directly into /usr/local/bin
tar -xzf "$ARCHIVE" -C /usr/local/bin/

# 1. Check if the binary exists at the destination
if [ ! -f "$TARGET" ]; then
  echo "--------------------------------------------------------"
  echo "INSTALLATION FAILED: $TARGET does not exist after extraction!"
  echo "Archive contents were:"
  tar -ztvf "$ARCHIVE"
  echo "--------------------------------------------------------"
  exit 1
fi

# 2. Ensure executable permissions
chmod +x "$TARGET"

# 3. Check that it is actually executable
if [ ! -x "$TARGET" ]; then
  echo "ERROR: $TARGET exists but cannot be made executable."
  exit 1
fi

echo "Verified: $TARGET is present and executable."
echo "&name; plugin v&version; installed successfully."
</INLINE>
</FILE>

<!-- Install the .page template -->
<FILE Name="/usr/local/emhttp/plugins/&name;/SwissbitLTM.page">
<URL>&gitURL;/source/usr/local/emhttp/plugins/&name;/SwissbitLTM.page</URL>
</FILE>

<!-- Install the backend PHP script -->
<FILE Name="/usr/local/emhttp/plugins/&name;/SwissbitLTM.php">
<URL>&gitURL;/source/usr/local/emhttp/plugins/&name;/SwissbitLTM.php</URL>
</FILE>

<!-- STEP 4: Removal cleanup -->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
echo "Removing &name;..."
rm -f /usr/local/bin/sbdm-cli
rm -rf &plgPATH;
echo "&name; removed."
</INLINE>
</FILE>

</PLUGIN>
